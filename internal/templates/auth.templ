package templates

templ Login(registrationEnabled bool, errMsg string) {
	@Layout("Login", false) {
		<div class="flex min-h-[60vh] items-center justify-center">
			<div class="w-full max-w-sm card !p-8">
				<h1 class="font-display text-3xl text-gray-100 text-center mb-2">Meridian</h1>
				<p class="text-gray-500 text-center text-sm mb-8">
					Sign in to see your day more clearly
				</p>
				<form method="POST" action="/login" class="space-y-4">
					<input id="login-redirect" type="hidden" name="redirect"/>
					<div>
						<input
							type="email"
							name="identity"
							placeholder="Email"
							autocomplete="email"
							required
							class="input-field"
						/>
					</div>
					<div>
						<input
							type="password"
							name="password"
							placeholder="Password"
							autocomplete="current-password"
							required
							class="input-field"
						/>
					</div>
					<button
						type="submit"
						class="btn-primary"
					>
						Sign In
					</button>
					if errMsg != "" {
						<p class="text-sm text-dawn text-center">{ errMsg }</p>
					}
				</form>
				if registrationEnabled {
					<p class="mt-6 text-center text-xs text-gray-400">
						Don't have an account? <a href="/register" class="text-dusk hover:text-dawn underline underline-offset-2 transition-colors">Create one</a>
					</p>
				}
			</div>
		</div>
		<script>
			const params = new URLSearchParams(window.location.search);
			document.getElementById('login-redirect').value = params.get('redirect') || '';
		</script>
	}
}

templ Register(errMsg string) {
	@Layout("Register", false) {
		<div class="flex min-h-[60vh] items-center justify-center">
			<div class="w-full max-w-sm card !p-8">
				<h1 class="font-display text-3xl text-gray-100 text-center mb-2">Create Account</h1>
				<p class="text-gray-500 text-center text-sm mb-8">
					Sign up to start tracking your energy
				</p>
				<form method="POST" action="/register" class="space-y-4">
					<div>
						<input
							type="email"
							name="email"
							placeholder="Email"
							autocomplete="email"
							required
							class="input-field"
						/>
					</div>
					<div>
						<input
							type="password"
							name="password"
							placeholder="Password (min 8 characters)"
							autocomplete="new-password"
							required
							minlength="8"
							class="input-field"
						/>
					</div>
					<div>
						<input
							type="password"
							name="password_confirm"
							placeholder="Confirm password"
							autocomplete="new-password"
							required
							minlength="8"
							class="input-field"
						/>
					</div>
					if errMsg != "" {
						<p class="text-sm text-dawn text-center">{ errMsg }</p>
					}
					<button
						type="submit"
						class="btn-primary"
					>
						Create Account
					</button>
				</form>
				<p class="mt-6 text-center text-xs text-gray-400">
					Already have an account? <a href="/login" class="text-dusk hover:text-dawn underline underline-offset-2 transition-colors">Sign in</a>
				</p>
			</div>
		</div>
	}
}
