package templates

import (
	"fmt"
	"time"
	"github.com/drewbitt/meridian/internal/engine"
	"github.com/drewbitt/meridian/internal/services"
)


templ Dashboard(schedule engine.Schedule, debt engine.SleepDebt, resolvedHabits []services.ResolvedHabit) {
	@Layout("Dashboard") {
		<div class="space-y-8">
				<div class={ dashboardSummaryGridClass(schedule) }>
					<div class="lg:col-span-1">
						@DebtCard(debt)
					</div>

					if len(schedule.Points) > 0 {
						<div class="lg:col-span-2">
							<div>
								<h1 class="font-display text-lg text-gray-100 mb-4">Modeled Energy Curve</h1>
								<div class="relative h-64 surface">
									<canvas id="energy-chart"></canvas>
								</div>
							</div>
						</div>
					}
			</div>

			@TodaySchedule(schedule)

			if len(schedule.Points) > 0 {
				<div>
					<h2 class="text-xs font-mono uppercase tracking-widest text-gray-400 mb-3">Key Times</h2>
					<div class={ keyTimeGridClass(schedule), " gap-px bg-night-border rounded-lg overflow-hidden" }>
						if !schedule.BestFocusStart.IsZero() {
							@TimeCard("Modeled High Energy", "noon") {
								<local-time datetime={ isoTime(schedule.BestFocusStart) }></local-time>
								{ " – " }
								<local-time datetime={ isoTime(schedule.BestFocusEnd) }></local-time>
							}
						}
						@TimeCard("Caffeine Cutoff", "ember") {
							<local-time datetime={ isoTime(schedule.CaffeineCutoff) }></local-time>
						}
						if !schedule.OptimalNapStart.IsZero() {
							@TimeCard("Nap Window", "horizon") {
								<local-time datetime={ isoTime(schedule.OptimalNapStart) }></local-time>
								{ " – " }
								<local-time datetime={ isoTime(schedule.OptimalNapEnd) }></local-time>
							}
						}
						@TimeCard("Estimated Wind-Down", "twilight") {
							<local-time datetime={ isoTime(schedule.MelatoninWindow) }></local-time>
						}
					</div>
				</div>

				@HabitTimeline(resolvedHabits)
			}
		</div>

			if len(schedule.Points) > 0 {
				@templ.JSONScript("energy-points", schedule.Points)
				<script src="/assets/dist/chart.umd.min.js"></script>
				<script>
			let chart = null;
			const fmt = window.__timeFmt;

			window.updateEnergyChart = function(points) {
				const ctx = document.getElementById('energy-chart');
				if (!ctx) return;

				const labels = points.map(p => fmt.format(new Date(p.time)));
				const data = points.map(p => p.alertness);
				const zones = points.map(p => p.zone);

				const zoneColors = {
					'sleep_inertia': 'rgba(251, 146, 60, 0.25)',
					'morning_peak': 'rgba(251, 191, 36, 0.25)',
					'afternoon_dip': 'rgba(244, 165, 184, 0.20)',
					'evening_peak': 'rgba(251, 191, 36, 0.25)',
					'wind_down': 'rgba(167, 139, 250, 0.25)',
					'melatonin_window': 'rgba(129, 140, 248, 0.25)',
					'normal': 'rgba(30, 39, 68, 0.4)',
					'sleep': 'rgba(6, 9, 16, 0.6)',
				};
				const bgColors = zones.map(z => zoneColors[z] || 'rgba(30, 39, 68, 0.4)');

				if (chart) {
					chart.data.labels = labels;
					chart.data.datasets[0].data = data;
					chart.data.datasets[0].backgroundColor = bgColors;
					chart.data.datasets[0].borderColor = 'rgba(129, 140, 248, 0.7)';
					chart.update('none');
					return;
				}

				chart = new Chart(ctx, {
					type: 'line',
					data: {
						labels: labels,
						datasets: [{
							label: 'Modeled alertness',
							data: data,
							borderColor: 'rgba(129, 140, 248, 0.7)',
							backgroundColor: bgColors,
							fill: true,
							tension: 0.4,
							pointRadius: 0,
							pointHoverRadius: 6,
							pointHitRadius: 20,
							borderWidth: 2,
						}]
					},
					options: {
						responsive: true,
						maintainAspectRatio: false,
						scales: {
							x: {
								ticks: { color: '#4b5563', maxTicksLimit: 12, font: { family: "'DM Sans', sans-serif", size: 11 } },
								grid: { color: 'rgba(30, 39, 68, 0.6)' },
								border: { color: 'rgba(30, 39, 68, 0.6)' },
							},
							y: {
								ticks: { color: '#4b5563', font: { family: "'DM Sans', sans-serif", size: 11 } },
								grid: { color: 'rgba(30, 39, 68, 0.6)' },
								border: { color: 'rgba(30, 39, 68, 0.6)' },
								title: { display: true, text: 'Modeled alertness', color: '#4b5563', font: { family: "'DM Sans', sans-serif" } },
							},
						},
						interaction: { mode: 'index', intersect: false },
						plugins: {
							legend: { display: false },
						},
					},
				});
			};
			const energyPoints = document.getElementById('energy-points');
			if (energyPoints) window.updateEnergyChart(JSON.parse(energyPoints.textContent));
				</script>
			}
	}
}

templ DebtCard(debt engine.SleepDebt) {
	<div id="debt-card" class="hero-stat">
		<div class="text-xs font-mono uppercase tracking-widest text-gray-400 mb-4">Sleep Debt</div>
		if debt.ObservedNights == 0 {
			<div class="font-display text-6xl leading-none text-gray-500">—</div>
			<div class="text-sm mt-3 font-medium font-mono text-gray-400">
				not enough data
			</div>
		} else if debt.IsLowerBound {
			<div class={ "font-display text-6xl leading-none", debtColor(debt.Category) }>
				{ fmt.Sprintf("%.1fh", debt.Hours) }
			</div>
			<div class="text-sm mt-3 font-medium font-mono text-amber-500">
				observed lower bound
			</div>
		} else {
			<div class={ "font-display text-6xl leading-none", debtColor(debt.Category) }>
				{ fmt.Sprintf("%.1fh", debt.Hours) }
			</div>
			<div class={ "text-sm mt-3 font-medium capitalize font-mono", debtColor(debt.Category) }>
				{ string(debt.Category) }
			</div>
		}
		if debt.Freshness == engine.FreshnessStale || debt.Freshness == engine.FreshnessInsufficient {
			<div class="mt-3 text-xs font-mono text-amber-500">
				{ fmt.Sprintf("%d of 14 nights observed", debt.ObservedNights) }
			</div>
		} else if debt.Freshness == engine.FreshnessRecent {
			if debt.LastNightMissing {
				<div class="mt-3 text-xs font-mono text-gray-500">
					last night estimated from recent sleep
				</div>
			} else {
				<div class="mt-3 text-xs font-mono text-gray-500">
					{ fmt.Sprintf("%d of 14 nights estimated", debt.EstimatedNights) }
				</div>
			}
		}
		if debt.NapCreditHours > 0 {
			<div class="mt-2 text-xs font-mono text-gray-500">
				{ fmt.Sprintf("%.1fh nap recovery included", debt.NapCreditHours) }
			</div>
		}
	</div>
}

templ TodaySchedule(schedule engine.Schedule) {
	<div id="today-schedule" class="section-ruled">
		<h2 class="font-display text-lg text-gray-100 mb-4">Today</h2>
		if len(schedule.Points) == 0 {
			if schedule.AwaitingSleepData {
				<p class="text-gray-400">
					<span class="text-amber-500">Waiting for today's completed Fitbit sleep.</span>
					Meridian retries every 30 minutes and will replace this state automatically when Fitbit publishes it.
					if !schedule.LastSync.IsZero() {
						<span> Last checked { formatScheduleSync(schedule.LastSync) }.</span>
					}
					<a href="/settings" class="text-dusk hover:text-dawn transition-colors underline underline-offset-2">Sync now</a>.
				</p>
			} else if schedule.Confidence == engine.ConfidenceLow && schedule.ConfidenceReason != "" {
				<p class="text-gray-400"><span class="text-amber-500">No reliable timing forecast:</span> { schedule.ConfidenceReason }. Meridian will keep showing the sleep data it can support without inventing precise peaks.</p>
			} else if schedule.ObservedNights > 0 {
				<p class="text-gray-400">No recent main sleep was found, so Meridian is not guessing today's curve. <a href="/sleep" class="text-dusk hover:text-dawn transition-colors underline underline-offset-2">Check or log your sleep</a>.</p>
			} else {
				<p class="text-gray-400">No sleep data yet. <a href="/sleep" class="text-dusk hover:text-dawn transition-colors underline underline-offset-2">Log your sleep</a> to see your energy schedule.</p>
			}
		} else {
			<div class="mb-4 rounded-lg border border-night-border bg-night-deep/40 px-4 py-3 text-xs font-mono text-gray-400">
				if schedule.Confidence == engine.ConfidencePreliminary {
					<span class="text-amber-500">Preliminary forecast</span>
					<span> · { fmt.Sprintf("%d of 14 nights observed", schedule.ObservedNights) }</span>
				} else if schedule.Confidence == engine.ConfidenceLow {
					<span class="text-amber-500">Low-confidence forecast</span>
					<span> · { schedule.ConfidenceReason }</span>
				} else if schedule.Confidence == engine.ConfidenceHigh {
					<span class="text-emerald-400">Higher-confidence forecast</span>
					<span> · recent sleep timing personalized</span>
				} else {
					<span>Moderate-confidence forecast</span>
					if schedule.IsEstimate {
						<span> · missing debt days estimated from your median sleep</span>
					}
				}
				<span class="block mt-1">Based on main sleep ending <local-time datetime={ isoTime(schedule.MorningWake) }></local-time>.</span>
				if schedule.EnergyPattern == engine.PatternTwoPeak {
					<span class="block mt-1">Two distinct highs and an intervening dip met the display threshold.</span>
				} else if schedule.EnergyPattern == engine.PatternOnePeak {
					<span class="block mt-1">One clear high is modeled today; Meridian is not inventing a second peak.</span>
				}
			</div>
			<div class="flex gap-2 flex-wrap">
					for _, zone := range uniqueZones(schedule.Points) {
						<span class={ "inline-flex items-center rounded-md px-3 py-1 text-xs font-mono font-medium", zoneBadgeClass(zone) }>
							{ zoneLabel(zone, schedule.EnergyPattern) }
						</span>
				}
			</div>
		}
	</div>
}

func formatScheduleSync(syncTime time.Time) string {
	elapsed := time.Since(syncTime)
	switch {
	case elapsed < time.Minute:
		return "just now"
	case elapsed < time.Hour:
		return fmt.Sprintf("%d minutes ago", max(1, int(elapsed.Minutes())))
	default:
		return fmt.Sprintf("%d hours ago", max(1, int(elapsed.Hours())))
	}
}

templ TimeCard(label, colorName string) {
	<div class={ "bg-night p-4", timeCardBorder(colorName) }>
		<div class="text-xs font-mono uppercase tracking-widest text-gray-400">{ label }</div>
		<div class={ "text-sm font-semibold mt-1.5 font-mono", timeCardText(colorName) }>
			{ children... }
		</div>
	</div>
}

// isoTime returns an RFC 3339 UTC string for use in <time datetime="…">.
func isoTime(t time.Time) string {
	return t.UTC().Format(time.RFC3339)
}

func timeCardBorder(colorName string) string {
	switch colorName {
	case "noon":
		return "border-t-2 border-t-noon"
	case "ember":
		return "border-t-2 border-t-ember"
	case "horizon":
		return "border-t-2 border-t-horizon"
	case "twilight":
		return "border-t-2 border-t-twilight"
	default:
		return "border-t-2 border-t-dusk"
	}
}

func timeCardText(colorName string) string {
	switch colorName {
	case "noon":
		return "text-noon"
	case "ember":
		return "text-ember"
	case "horizon":
		return "text-horizon"
	case "twilight":
		return "text-twilight"
	default:
		return "text-dusk"
	}
}

func keyTimeGridClass(schedule engine.Schedule) string {
	if schedule.OptimalNapStart.IsZero() {
		return "grid grid-cols-1 sm:grid-cols-3"
	}
	return "grid grid-cols-2 sm:grid-cols-4"
}

func dashboardSummaryGridClass(schedule engine.Schedule) string {
	if len(schedule.Points) == 0 {
		return "grid grid-cols-1 gap-8 items-start max-w-sm"
	}
	return "grid grid-cols-1 gap-8 lg:grid-cols-3 items-start"
}

func debtColor(cat engine.DebtCategory) string {
	switch cat {
	case engine.DebtNone:
		return "text-noon"
	case engine.DebtLow:
		return "text-horizon"
	case engine.DebtModerate:
		return "text-ember"
	case engine.DebtHigh, engine.DebtSevere:
		return "text-dawn"
	default:
		return "text-gray-500"
	}
}

func uniqueZones(points []engine.EnergyPoint) []string {
	seen := map[string]bool{}
	var zones []string
	for _, p := range points {
		if !seen[p.Zone] && p.Zone != engine.ZoneSleep && p.Zone != engine.ZoneNormal {
			seen[p.Zone] = true
			zones = append(zones, p.Zone)
		}
	}
	return zones
}

func zoneLabel(zone, pattern string) string {
	switch zone {
	case engine.ZoneSleepInertia:
		return "Sleep Inertia"
	case engine.ZoneMorningPeak:
		if pattern == engine.PatternOnePeak {
			return "Modeled High"
		}
		return "Modeled First High"
	case engine.ZoneAfternoonDip:
		return "Modeled Dip"
	case engine.ZoneEveningPeak:
		if pattern == engine.PatternOnePeak {
			return "Modeled High"
		}
		return "Modeled Second High"
	case engine.ZoneWindDown:
		return "Energy Declining"
	case engine.ZoneMelatoninWindow:
		return "Estimated Wind-Down"
	default:
		return zone
	}
}

func zoneBadgeClass(zone string) string {
	switch zone {
	case engine.ZoneSleepInertia:
		return "bg-ember-muted text-ember"
	case engine.ZoneMorningPeak:
		return "bg-noon-muted text-noon"
	case engine.ZoneAfternoonDip:
		return "bg-dawn-muted text-dawn"
	case engine.ZoneEveningPeak:
		return "bg-noon-muted text-noon"
	case engine.ZoneWindDown:
		return "bg-twilight-muted text-twilight"
	case engine.ZoneMelatoninWindow:
		return "bg-dusk-muted text-dusk"
	default:
		return "bg-night-border text-gray-400"
	}
}
