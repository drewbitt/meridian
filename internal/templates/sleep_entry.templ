package templates

templ SleepEntry() {
	@Layout("Log Sleep") {
		<div class="mx-auto max-w-lg">
			<h1 class="font-display text-2xl text-gray-100 mb-6">Log Sleep</h1>
			<form method="POST" action="/sleep" class="space-y-5">
				<input type="hidden" name="tz" id="tz-input"/>
				<script type="module">
					document.getElementById('tz-input').value = Temporal.Now.timeZoneId();
				</script>
				<div>
					<label for="sleep_start" class="block text-sm font-medium text-gray-400 mb-1.5">
						Bedtime
					</label>
					<input
						type="datetime-local"
						id="sleep_start"
						name="sleep_start"
						required
						class="input-field"
						onclick="this.showPicker()"
					/>
				</div>
				<div>
					<label for="sleep_end" class="block text-sm font-medium text-gray-400 mb-1.5">
						Wake time
					</label>
					<input
						type="datetime-local"
						id="sleep_end"
						name="sleep_end"
						required
						class="input-field"
						onclick="this.showPicker()"
					/>
				</div>
				<label class="flex items-start gap-3 rounded-lg border border-night-border bg-night-deep/40 px-4 py-3">
					<input
						type="checkbox"
						id="is_nap"
						name="is_nap"
						class="mt-0.5"
					/>
					<span>
						<span class="block text-sm font-medium text-gray-200">This was a nap</span>
						<span class="mt-0.5 block text-xs text-gray-400">Use this for a separate daytime or pre-shift sleep, not a broken segment of the same main sleep.</span>
					</span>
				</label>
				<button
					type="submit"
					class="btn-primary"
				>
					Save Sleep Entry
				</button>
			</form>
		</div>
	}
}
