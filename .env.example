# "first-user" closes registration automatically after the initial account.
# Use "true" only for intentional multi-user registration.
ALLOW_REGISTRATION=first-user

# Server fallback; each user chooses their own IANA time zone in Meridian.
TZ=UTC

# Optional instance-wide Google OAuth web client. Set both values to let every
# Meridian user connect without entering credentials in Settings.
GOOGLE_HEALTH_CLIENT_ID=
GOOGLE_HEALTH_CLIENT_SECRET=

# Host port for the web app.
MERIDIAN_PORT=8090

# Moving prerelease channel. Pin an immutable version such as 0.2.0-beta.1 for
# controlled upgrades, or use latest after Meridian has a stable release.
MERIDIAN_TAG=beta
