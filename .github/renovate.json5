{
	$schema: 'https://docs.renovatebot.com/renovate-schema.json',
	extends: ['config:recommended', ':semanticCommits'],
	configMigration: true,
	platformAutomerge: true,
	postUpdateOptions: ['gomodTidy'],
	constraints: {
		go: '1.26'
	},
	minimumReleaseAge: '3 days',
	prConcurrentLimit: 5,
	timezone: 'America/New_York',
	vulnerabilityAlerts: {
		enabled: true,
		labels: ['security'],
		minimumReleaseAge: '0 days',
		schedule: ['at any time']
	},
	labels: ['dependencies'],
	customManagers: [
		{
			customType: 'regex',
			description: 'Update version arguments documented with Renovate comments',
			managerFilePatterns: ['/(^|/)Dockerfile$/'],
			matchStrings: [
				'# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+ARG TAILWIND_VERSION=(?<currentValue>\\S+)'
			],
			versioningTemplate: 'semver'
		}
	],
	packageRules: [
		{
			matchUpdateTypes: ['minor', 'patch', 'pin', 'digest'],
			automerge: true,
			schedule: ['after 5:00pm on Monday']
		},
		{
			matchUpdateTypes: ['major'],
			dependencyDashboardApproval: true
		},
		{
			description: 'Keep the templ generator and Go module on the same version',
			matchPackageNames: ['/^github\\.com\\/a-h\\/templ(?:\\/cmd\\/templ)?$/'],
			groupName: 'templ'
		},
		{
			description: 'Keep Tailwind versions in mise and Docker aligned',
			matchPackageNames: ['tailwindlabs/tailwindcss'],
			groupName: 'tailwindcss'
		},
		{
			description: 'Keep Go toolchain versions aligned',
			matchPackageNames: ['go', 'golang'],
			groupName: 'Go toolchain'
		},
		{
			description: 'Only propose Go modules supported by the project Go version',
			matchManagers: ['gomod'],
			constraintsFiltering: 'strict'
		},
		{
			matchDatasources: ['go'],
			matchPackageNames: ['/^golang\\.org/x//'],
			groupName: 'golang.org/x packages'
		},
		{
			matchDatasources: ['go'],
			matchPackageNames: ['/^modernc\\.org//'],
			groupName: 'modernc.org packages'
		}
	]
}
